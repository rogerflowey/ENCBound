enclave {
    from "sgx_tstdc.edl" import *;
    include "ocall_types.h"
    trusted {
        public void ecall_opendb([in, string] const char *dbname);
        public void ecall_execute_sql([in, string] const char *sql);
        public void ecall_closedb(void);
    };
    untrusted {
        void ocall_println_string([in, string] const char *str);
        void ocall_print_string([in, string] const char *str);
        void ocall_print_error([in, string] const char *str);
        int ocall_lstat([in, string] const char *path, [in, out, size=size] struct stat *buf, size_t size) propagate_errno;
        int ocall_stat([in, string] const char *path, [in, out, size=size] struct stat *buf, size_t size) propagate_errno;
        int ocall_fstat(int fd, [in, out, size=size] struct stat *buf, size_t size) propagate_errno;
        int ocall_ftruncate(int fd, off_t length) propagate_errno;
        char *ocall_getcwd([out, size=size] char *buf, size_t size) propagate_errno;
        int ocall_getpid(void) propagate_errno;
        int ocall_getuid(void) propagate_errno;
        char *ocall_getenv([in, string] const char *name);
        int ocall_open64([in, string] const char *filename, int flags, mode_t mode) propagate_errno;
        int ocall_close(int fd) propagate_errno;
        off_t ocall_lseek64(int fd, off_t offset, int whence) propagate_errno;
        int ocall_read(int fd, [out, size=count] void *buf, size_t count) propagate_errno;
        int ocall_write(int fd, [in, size=count] const void *buf, size_t count) propagate_errno;
        int ocall_fsync(int fd) propagate_errno;
        int ocall_fcntl(int fd, int cmd, [in, out, size=size] void *arg, size_t size) propagate_errno;
        int ocall_unlink([in, string] const char *pathname) propagate_errno;
        int ocall_access([in, string] const char *pathname, int mode) propagate_errno;
        int ocall_mkdir([in, string] const char *pathname, mode_t mode) propagate_errno;
        int ocall_rmdir([in, string] const char *pathname) propagate_errno;
        int ocall_fchmod(int fd, mode_t mode) propagate_errno;
        int ocall_fchown(int fd, unsigned int owner, unsigned int group) propagate_errno;
        int ocall_utimes([in, string] const char *pathname, [in, size=size] void *times, size_t size) propagate_errno;
        long ocall_readlink([in, string] const char *pathname, [out, size=count] char *buf, size_t count) propagate_errno;
        int ocall_gettimeofday([out, size=size] void *tv, size_t size) propagate_errno;
        int ocall_localtime(long t, [out, size=size] void *tm, size_t size) propagate_errno;
        unsigned int ocall_sleep(unsigned int seconds) propagate_errno;
        long ocall_time(void) propagate_errno;
        long ocall_sysconf(int name) propagate_errno;
    };
};
