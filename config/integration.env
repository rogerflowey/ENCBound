# Default for NEW application integrations. POSIX shell and GNU Make syntax.
# Shell: . ./config/integration.env
# Make:  include $(ROOT)/config/integration.env  (before recipe defaults)
# See config/README.md for library, boundary and ownership requirements.
export ENCBOUND_INTEGRATION_PRESET=all-compat-v1
export ENCBOUND_CALLBACKS=1
export ENCBOUND_AGGREGATE_ABI=1
export ENCBOUND_CXX_ALLOCATIONS=1
export ENCBOUND_ATOMICS=1
export ENCBOUND_VIRTUALS=1
export ENCBOUND_VARIADICS=1
export ENCBOUND_WRITABLE_GLOBALS=1
export ENCBOUND_PROTECTED_GLOBALS=1
export ENCBOUND_CXX_LIFECYCLE=1
export ENCBOUND_VLA=1
export ENCBOUND_APP_ERRNO=1
export ENCBOUND_CODEGEN_OPT=-O2
export ENCBOUND_CHECK_REUSE=off
export ENCBOUND_LOCAL_PROOFS=0
export ENCBOUND_FAST_PATHS=off

# Names used by the existing Make recipes; keep their compiler settings aligned.
export PROTECTED_GLOBALS=1
export APP_CODEGEN_OPT=-O2
export CHECK_REUSE=off
export LOCAL_PROOFS=0
export FAST_PATHS=off
